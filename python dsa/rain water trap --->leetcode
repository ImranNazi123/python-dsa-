class Solution:
    def trap(self, height: List[int]) -> int:
        n=len(height)
        li=[None]*n
            # li=[]
        ri=[None]*n

        li[0]=height[0]
        for i in range(1,n):
                # left max
            li[i]=max(li[i-1],height[i])

        ri[n-1]=height[n-1]
            # right max
        for j in range(n-2,-1,-1):
            ri[j]=max(ri[j+1],height[j])

        sum=0
        for i in range(n):
            sum+=min(li[i],ri[i])-height[i]

        return sum
            


                
